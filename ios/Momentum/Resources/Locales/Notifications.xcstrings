    "notifications.permission.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your coach will nudge you at the right moments — check-ins, streaks, and replies. No spam, no background noise."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre coach vous contactera aux bons moments : rappels, séries, réponses. Pas de spam, pas de bruit."
          }
        }
      }
    },
