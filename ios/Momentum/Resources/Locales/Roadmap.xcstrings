    "roadmap.task.focus.easy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quick win to fuel your momentum. Nail it early in the day and the rest falls into place."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une victoire rapide pour entretenir ton élan. Boucle-la tôt et la journée s'enchaîne."
          }
        }
      }
    },
    "roadmap.task.focus.moderate" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give this steady focus — reserve a solid block of time and work through it without switching tabs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne-lui une attention régulière — réserve un vrai créneau et avance sans te disperser."
          }
        }
      }
    },
    "roadmap.task.focus.hard" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the one that moves the needle. Carve out deep focus, silence the noise, and go all in."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celle qui fait vraiment bouger les choses. Dégage un vrai temps de concentration et engage-toi à fond."
          }
        }
      }
    },
    "roadmap.task.focus.unrated" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay intentional — take it one step at a time and keep the bigger picture in view."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reste intentionnel — un pas après l'autre, en gardant l'objectif en tête."
          }
        }
      }
    },
