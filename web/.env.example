# Supabase (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role (server-only) — used by legacy lib/supabase/admin.ts; removed in Phase 2.
SUPABASE_SERVICE_ROLE_KEY=

# NestJS admin API base URL — server-only (do NOT prefix with NEXT_PUBLIC_).
# API mounts under /api, so this should end in /api.
ADMIN_API_URL=http://localhost:3000/api
